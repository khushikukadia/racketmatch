# --- Database --------------------------------------------------------------
# Alembic and the API read DATABASE_URL from .env (see app/config.py).

# Supabase — IMPORTANT:
# The "Direct connection" host db.<ref>.supabase.co is often IPv6-only. If you get
# "could not translate host name", use the SESSION POOLER URI instead:
#   Dashboard → Project Settings → Database → Connection pooling → "Session mode"
# Host looks like aws-0-<region>.pooler.supabase.com — usually works on IPv4-only Wi‑Fi.
#
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
#
# Local PostgreSQL on macOS (Homebrew): there is often NO user named "postgres".
# Use your macOS username instead, or create the role (see README).
# DATABASE_URL=postgresql://YOUR_USERNAME@localhost:5432/racketmatch
#
# Local Docker-style default:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/racketmatch

DATABASE_URL=postgresql://YOUR_USERNAME@localhost:5432/racketmatch

# Supabase project URL (required for verifying NEW asymmetric JWT signing keys via JWKS).
# Dashboard → Project Settings → API → "Project URL"
SUPABASE_URL=https://your-project-ref.supabase.co

# Legacy HS256 JWT secret (still works for older Supabase projects).
# Dashboard → Project Settings → API → "JWT Secret".
# If your dashboard shows it as "legacy" because the project uses asymmetric
# JWT signing keys, you can leave this blank and rely on SUPABASE_URL+JWKS.
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-from-project-settings

# Optional: bypass JWT and use this user id for local API testing (UUID)
# MOCK_AUTH_USER_ID=

CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,exp://192.168.1.1:8081
